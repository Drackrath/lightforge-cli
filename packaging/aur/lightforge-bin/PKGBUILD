# Maintainer: Kenny <onlyusemycontroler@gmail.com>
#
# The prebuilt binary from the release page: built on Ubuntu 22.04 and checked
# to need no glibc newer than 2.35, so it runs on anything newer. For a source build, see
# `lightforge`.

pkgname=lightforge-bin
pkgver=1.0.0beta.11
pkgrel=1
# See the note in the `lightforge` PKGBUILD for why the version loses its
# hyphen here.
_tag=v1.0.0-beta.11
pkgdesc='Command-line tool to install, update and play World of Warcraft on Linux'
arch=('x86_64')
url='https://github.com/LightforgeProject/lightforge'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'python')
optdepends=(
  'lib32-gnutls: 32-bit runtime for Battle.net (needs multilib)'
  'lib32-freetype2: 32-bit runtime for Battle.net (needs multilib)'
  'lib32-vulkan-icd-loader: 32-bit runtime for Battle.net (needs multilib)'
  'mangohud: the in-game overlay Lightforge can enable per game'
)
provides=("lightforge=$pkgver")
conflicts=('lightforge')
# The binary arrives stripped. Without this `makepkg` strips them again and
# builds an empty `-debug` package out of what it does not find.
options=('!debug' '!strip')
source=("lightforge-${_tag#v}::$url/releases/download/$_tag/lightforge_linux_x86_64"
        "LICENSE-${_tag#v}::https://raw.githubusercontent.com/LightforgeProject/lightforge/$_tag/LICENSE")
# Of the binary attached to the release, as published in its SHA256SUMS.
# Fill in with `updpkgsums` once the release exists.
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 "lightforge-${_tag#v}" "$pkgdir/usr/bin/lightforge"
  install -Dm644 "LICENSE-${_tag#v}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
